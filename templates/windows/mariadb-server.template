param(
    [Parameter(Position=0)]
    [ValidateSet('start', 'stop')]
    [string]$Action,
    
    [Alias('V')]
    [switch]$VerboseOutput,

    [string]$Version = "##VERSION##",

    [int]$Port = 3306
)

$USER = if ($env:USERNAME) { $env:USERNAME } else { "root" }
$VERSION = "##VERSION##"
$HOME_DIR = Join-Path $env:USERPROFILE ".mariadb"
$DATADIR = Join-Path $HOME_DIR $VERSION
$LOGFILE = Join-Path $HOME_DIR "mariadb-service-$VERSION-$PID.log"
$LOGFILE_ERR = Join-Path $HOME_DIR "mariadb-service-$VERSION-$PID-err.log"
$SERVICE_LOGFILE = Join-Path $HOME_DIR "__ERROR_mariadb.service.log"

if (-not (Test-Path $HOME_DIR)) {
    New-Item -ItemType Directory -Path $HOME_DIR -Force | Out-Null
}

if (Test-Path $SERVICE_LOGFILE) {
    Clear-Content $SERVICE_LOGFILE
} else {
    New-Item -ItemType File -Path $SERVICE_LOGFILE -Force | Out-Null
    Clear-Content $SERVICE_LOGFILE
}

function Write-Log {
    param([string]$Message)
    if ($VerboseOutput) {
        Write-Host $Message
    }
}

function Write-ErrorWithLog {
    param([string]$ErrorMessage)
    
    Write-Host "ERROR: $ErrorMessage" -ForegroundColor Red
    
    Start-Sleep -Milliseconds 500
    
    $logs = @($LOGFILE, $LOGFILE_ERR)

    Write-Host "--- Command log ---" -ForegroundColor Red
    foreach ($log in $logs) {
        if ((Test-Path $log) -and ((Get-Item $log).Length -gt 0)) {
            # Kiírjuk a konzolra piros színnel
            Get-Content $log | ForEach-Object { 
                Write-Host $_ -ForegroundColor Red 
            }

            # Beírjuk a SERVICE_LOGFILE-ba
            Get-Content $log | ForEach-Object { 
                Add-Content -Path $SERVICE_LOGFILE -Value $_ 
            }
        }
    }
    Write-Host "--- End of log ---" -ForegroundColor Red

    foreach ($log in $logs) {
        if (Test-Path $log) { Remove-Item $log -Force -ErrorAction SilentlyContinue }
    }
    
    exit 1
}

function Clear-LogFiles {
    # Remove temp log files
    if (Test-Path $LOGFILE) {
        Remove-Item $LOGFILE -Force -ErrorAction SilentlyContinue
    }
    if (Test-Path $LOGFILE_ERR) {
        Remove-Item $LOGFILE_ERR -Force -ErrorAction SilentlyContinue
    }
    
    if ((Test-Path $SERVICE_LOGFILE) -and ((Get-Item $SERVICE_LOGFILE).Length -eq 0)) {
        Remove-Item $SERVICE_LOGFILE -Force -ErrorAction SilentlyContinue
    }
}

if (-not $Action) {
    Write-Host "Usage: script.ps1 {start|stop} [-VerboseOutput|-V] [-Port|-p <port>]"
    exit 1
}

switch ($Action) {
    'start' {
        if ($VerboseOutput) {
            $process = Start-Process -FilePath "mariadbd" `
                -ArgumentList "--datadir=`"$DATADIR`"", "--port=$Port", "--log-error=`"$LOGFILE`"" `
                -PassThru -NoNewWindow
        } else {
            $process = Start-Process -FilePath "mariadbd" `
                -ArgumentList "--datadir=`"$DATADIR`"", "--port=$Port", "--log-error=`"$LOGFILE`"" `
                -PassThru -NoNewWindow `
                -RedirectStandardOutput $LOGFILE `
                -RedirectStandardError $LOGFILE_ERR
        }
        
        Start-Sleep -Seconds 2
        
        if ($process.HasExited) {
            Write-ErrorWithLog "Failed to start MariaDB"
        }
        
        Write-Log "MariaDB $VERSION started"
        Clear-LogFiles
    }
    
    'stop' {
        if ($VerboseOutput) {
            $process = Start-Process -FilePath "mariadb-admin" `
                -ArgumentList "-u", $USER, "--port=$Port", "shutdown" `
                -Wait -PassThru -NoNewWindow
        } else {
            $process = Start-Process -FilePath "mariadb-admin" `
                -ArgumentList "-u", $USER, "--port=$Port", "shutdown" `
                -Wait -PassThru -NoNewWindow `
                -RedirectStandardOutput $LOGFILE `
                -RedirectStandardError $LOGFILE_ERR
        }
        
        Start-Sleep -Seconds 1
        
        if ($process.ExitCode -ne 0) {
            Write-ErrorWithLog "Failed to stop MariaDB"
        }
        
        Write-Log "MariaDB $VERSION stopped"
        Clear-LogFiles
    }
}
