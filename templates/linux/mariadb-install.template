#!/bin/bash

HOME_DIR="$HOME/.mariadb"
NEW_VERSION="##VERSION##"
NEW_DIR="$HOME_DIR/$NEW_VERSION"
BASEDIR="##BASEDIR##"

mkdir -p "$HOME_DIR"

check_existing_version() {
    if [ -d "$NEW_DIR" ] && [ "$(ls -A "$NEW_DIR")" ]; then
        echo "❌ Error: $NEW_DIR already exists and is not empty."
        echo "Check the ~/.mariadb folder and, if necessary, remove the previous installation."
        exit 1
    fi
}

list_previous_versions() {
    VERSIONS=()
    for dir in "$HOME_DIR"/*/; do
        [[ -d "$dir" ]] || continue
        [[ -n "$(ls -A "$dir")" ]] || continue  # exclude empty dirs
        base=$(basename "$dir")
        [[ $base =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && VERSIONS+=("$base")
    done

    IFS=$'\n' VERSIONS_SORTED=($(sort -V <<<"${VERSIONS[*]}"))
    unset IFS
}

choose_version() {
    if [ ${#VERSIONS_SORTED[@]} -eq 0 ]; then
        echo "No previous version found; performing a clean installation."
        CHOICE="clean"
    else
        echo "Available previous versions:"
        i=1
        for v in "${VERSIONS_SORTED[@]}"; do
            echo "[$i] $v"
            ((i++))
        done
        echo "[$i] Clean installation"
        read -p "Choose a version or clean installation: " sel
        if [[ $sel -ge 1 && $sel -lt $i ]]; then
            CHOICE="${VERSIONS_SORTED[$((sel-1))]}"
        else
            CHOICE="clean"
        fi
    fi
}

use_existing_version() {
    read -p "How should the new version be made available? [symlink/copy]: " LINK_OPTION
    if [ "$LINK_OPTION" == "symlink" ]; then
        ln -sfn "$HOME_DIR/$CHOICE" "$NEW_DIR"
        echo "Symlink created: $NEW_DIR -> $HOME_DIR/$CHOICE"
        exit 0
    elif [ "$LINK_OPTION" == "copy" ]; then
        SOCK_FILE="$HOME_DIR/$CHOICE/mariadb-$CHOICE.sock"
        if [ -S "$SOCK_FILE" ]; then
            echo "Running MariaDB socket: $SOCK_FILE"
            echo "Stop the running instance before continuing."
            exit 1
        fi
        cp -r "$HOME_DIR/$CHOICE/"* "$NEW_DIR/"
        echo "Copy completed: $NEW_DIR contains $CHOICE files"
        exit 0
    fi

    use_existing_version
}

perform_clean_install() {
    DATADIR="$NEW_DIR"

    if [ -x "$BASEDIR/scripts/mysql_install_db" ]; then
        echo "ℹ️ Using mysql_install_db..."
        CMD="$BASEDIR/scripts/mysql_install_db --basedir=\"$BASEDIR\" --datadir=\"$DATADIR\""
    elif [ -x "$BASEDIR/scripts/mariadb-install-db" ]; then
        echo "ℹ️ Using mariadb-install-db..."
        CMD="$BASEDIR/scripts/mariadb-install-db --basedir=\"$BASEDIR\" --datadir=\"$DATADIR\""
    else
        echo "ℹ️ Using modern initialization with mariadbd --initialize-insecure..."
        CMD="$BASEDIR/bin/mariadbd --initialize-insecure --basedir=\"$BASEDIR\" --datadir=\"$DATADIR\""
    fi

    echo "ℹ️ Executing: $CMD"
    eval $CMD

    echo "✅ Installation complete! Version $NEW_VERSION is in the $DATADIR directory."
}

# ---------- Logic ----------

check_existing_version
list_previous_versions
choose_version

if [ "$CHOICE" != "clean" ]; then
    use_existing_version
else
    perform_clean_install
fi
